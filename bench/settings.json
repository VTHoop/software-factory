{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(command -v gh)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git status --porcelain)",
      "Bash(git worktree add --detach:*)",
      "Bash(git worktree remove:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git branch:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status)",
      "Bash(gh api user:*)",
      "Bash(gh api --paginate \"repos/*/issues/*/comments?per_page=100\" --jq *)",
      "Write(//tmp/**)",
      "Write(//private/tmp/**)",
      "mcp__linear__get_issue"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push:*)",
      "Write(.github/**)",
      "Edit(.github/**)"
    ]
  }
}
